# ==============================================================================
# Antigravity AI Agent - Environment Configuration
# ==============================================================================

# Authentication & Session Security (Auth.js)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-string-here"

# Neon Postgres Database URL
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
POSTGRES_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AI Model Providers & Gateway
# Provide either AI_GATEWAY_API_KEY, OPENAI_API_KEY, or ANTHROPIC_API_KEY
AI_GATEWAY_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Composio Integration (External Tools & OAuth)
# Obtain from: https://app.composio.dev
COMPOSIO_API_KEY=""

# Supermemory Integration (Long-Term Memory)
# Obtain from: https://supermemory.ai
SUPERMEMORY_API_KEY=""

# Telegram Bot Integration
# Obtain bot token and username from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Secret token to secure incoming webhook updates from Telegram (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret-token"

# Vercel Cron Secret Header
# Sent by Vercel Cron in the Authorization: Bearer <CRON_SECRET> header
CRON_SECRET="your-cron-secret-token"

# Public Application URL (Production Domain)
NEXT_PUBLIC_APP_URL="https://your-agent.vercel.app"
